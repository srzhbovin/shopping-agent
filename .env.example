LLM_MAX_OUTPUT_TOKENS=128
LLM_MAX_RETRIES=1
PROMPT_PATH=prompts
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=30
AGENT_TOKEN_BUDGET=1200
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_CRITIC_REVISIONS=2
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
AUTO_LOAD_DEMO=true
